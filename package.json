{
  "name": "zyva",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3000",
    "cf:build": "cross-env CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "cross-env CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "wrangler deploy --keep-vars",
    "cf:publish": "npm run cf:build && npm run cf:deploy",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.19.11",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.109.0",
    "leaflet": "1.9.4",
    "next": "16.3.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "11.1.2"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "autoprefixer": "10.4.19",
    "cross-env": "10.1.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "wrangler": "4.125.0"
  }
}

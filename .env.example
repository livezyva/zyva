# ZYVA — Environment Variables
# ----------------------------------------------------------------------
# The current build ships with local SQLite + OpenStreetMap tiles and
# does NOT require any external keys to run. The variables below are
# scaffolded for the production migration (Supabase/Postgres, Stripe,
# Cloudinary, Google Maps) described in the v1.0 spec.

# --- Database ---------------------------------------------------------
# For local dev the app uses ./data/zyva.db (better-sqlite3, seeded on boot).
# For production, switch lib/db.js to a Postgres driver and set:
DATABASE_URL=postgres://user:password@localhost:5432/zyva

# --- Auth / JWT -------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
NEXTAUTH_URL=http://localhost:3000

# --- Stripe (payments) ------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_DAILY_LISTING_EUR=5.00
STRIPE_PRICE_FEATURED_BOOSTER_EUR=15.00

# --- Cloudinary / media CDN ------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Maps -------------------------------------------------------------
# Optional: swap the OSM tile layer in components/MapView.jsx for
# Google Maps / Mapbox by providing a key.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Email / push -----------------------------------------------------
RESEND_API_KEY=
FCM_SERVER_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
